ENVIRONMENT=development

DATABASE_URL=sqlite:///./recoverai.db

# LLM Configuration
OPENAI_API_KEY=your-openai-api-key-here
OPENAI_MODEL=gpt-4o-mini
OPENAI_BASE_URL=

# Optional LangSmith
LANGCHAIN_TRACING_V2=false
LANGCHAIN_API_KEY=
LANGCHAIN_PROJECT=recover-ai

# Payment Provider: mock | razorpay
PAYMENT_PROVIDER=mock

# Razorpay (optional)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Communication Provider: mock | resend
COMMUNICATION_PROVIDER=mock

# Resend (optional)
RESEND_API_KEY=
EMAIL_FROM=onboarding@resend.dev

# Frontend URL (for payment link generation)
FRONTEND_URL=http://localhost:3000

# Backend URL
BACKEND_URL=http://localhost:8000
